datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEAM_MEMBER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  fullName     String
  role         Role          @default(TEAM_MEMBER)
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdEvents Event[]      @relation("EventCreator")
  assignedEvents EventMember[]
  uploadedPhotos Photo[]     @relation("PhotoUploader")

  @@map("users")
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?
  date        DateTime
  location    String?
  coverImage  String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator     User          @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  teamMembers EventMember[]
  photos      Photo[]
  galleries   Gallery[]

  @@map("events")
}

model EventMember {
  id         String   @id @default(uuid())
  eventId    String
  userId     String
  assignedAt DateTime @default(now())

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_members")
}

model Photo {
  id           String        @id @default(uuid())
  eventId      String
  uploadedBy   String
  publicId     String        @unique
  url          String
  secureUrl    String
  thumbnailUrl String?
  filename     String
  fileSize     Int
  width        Int?
  height       Int?
  isSelected   Boolean       @default(false)
  tags         String[]      @default([])
  createdAt    DateTime      @default(now())

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader     User          @relation("PhotoUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  galleryPhotos GalleryPhoto[]

  @@map("photos")
}

model Gallery {
  id          String        @id @default(uuid())
  eventId     String
  title       String
  slug        String        @unique
  pinHash     String
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  viewCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos      GalleryPhoto[]

  @@map("galleries")
}

model GalleryPhoto {
  id           String   @id @default(uuid())
  galleryId    String
  photoId      String
  displayOrder Int      @default(0)
  addedAt      DateTime @default(now())

  gallery      Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo        Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([galleryId, photoId])
  @@map("gallery_photos")
}
